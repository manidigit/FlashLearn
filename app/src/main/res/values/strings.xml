    <string name="about_title">درباره برنامه</string><string name="about_description">FlashLearn برای یادگیری واژگان اسپانیایی و فارسی ساخته شده و کاملاً آفلاین کار می‌کند. داشبورد آمار، نمودار فعالیت مرور با فیلترهای هفتگی، ماهانه، سه‌ماهه و همه، شاخص تعداد مرور، و محاسبه پیشرفت از اولین مرور واقعی را نیز در خود برنامه ارائه می‌دهد.</string><string name="about_features">واژه‌ها را می‌توان دستی یا گروهی اضافه کرد و با مرور روزانه، هفتگی و ماهانه تثبیت کرد. آزمون چهارگزینه‌ای، پیشرفت، آمار و پشتیبان‌گیری نیز در خود برنامه در دسترس هستند.</string><string name="about_technical_info">اطلاعات فنی</string><string name="about_version">نسخه</string><string name="about_version_code">شماره نسخه</string><string name="about_author">سازنده</string><string name="about_language">زبان برنامه‌نویسی</string><string name="about_database">نوع دیتابیس</string><string name="about_ai_assistant">هوش مصنوعی همکار در ساخت</string><string name="about_build_date">تاریخ Build</string><string name="about_github">GitHub: %1$s</string><string name="about_release_status">وضعیت نسخه</string><string name="about_installed_version">نسخه نصب‌شده: v%1$s (شماره %2$d)</string><string name="about_build_date_current">تاریخ Build این نسخه: %1$s</string><string name="about_build_configuration">مشخصات فنی و اطلاعات نسخه از Build Configuration پروژه خوانده می‌شوند؛ بنابراین با هر Build جدید، نسخه و تاریخ Build به‌صورت خودکار به‌روز می‌شوند.</string><string name="about_changelog_reference">برای تاریخچه کامل تغییرات، CHANGELOG مخزن پروژه مرجع است.</string><string name="addword_method_title">افزودن واژه جدید</string><string name="addword_single_words">لغات تکی</string><string name="addword_single_words_summary">افزودن یک واژه جدید</string><string name="addword_bulk_words">لغات گروهی</string><string name="addword_bulk_words_summary">وارد کردن چند واژه همزمان</string><string name="addword_restore_backup">ریستور بکاپ</string><string name="addword_restore_backup_summary">بازیابی واژه‌ها و اطلاعات از فایل پشتیبان</string><string name="addword_find_duplicates">پیدا کردن تکراری‌ها</string><string name="addword_needs_review">نیازمند بررسی (%1$d)</string><string name="addword_refresh">رفرش</string><string name="addword_total_words">تعداد کل واژگان</string>
