    <string name="about_title">About</string><string name="about_description">FlashLearn is an offline vocabulary learning app for Spanish and Persian. It includes statistics, review activity charts with weekly, monthly, three-month and all-time filters, review counts, and progress calculated from the first real review.</string><string name="about_features">Words can be added individually or in bulk and reinforced with daily, weekly, and monthly review. Multiple-choice quizzes, progress, statistics, and backups are also available.</string><string name="about_technical_info">Technical information</string><string name="about_version">Version</string><string name="about_version_code">Version code</string><string name="about_author">Author</string><string name="about_whatsapp">Creator WhatsApp</string><string name="about_whatsapp_number">+34 685 644 444</string><string name="about_language">Programming language</string><string name="about_database">Database</string><string name="about_ai_assistant">AI assistant used during development</string><string name="about_build_date">Build date</string><string name="about_github">GitHub: %1$s</string><string name="about_release_status">Release status</string><string name="about_installed_version">Installed version: v%1$s (code %2$d)</string><string name="about_build_date_current">Build date for this version: %1$s</string><string name="about_build_configuration">Technical and version information is read from the project Build Configuration, so each build updates the version and build date automatically.</string><string name="about_changelog_reference">See the repository CHANGELOG for the complete change history.</string><string name="addword_method_title">Add word</string><string name="addword_single_words">Single words</string><string name="addword_single_words_summary">Add one new word</string><string name="addword_bulk_words">Bulk words</string><string name="addword_bulk_words_summary">Import multiple words at once</string><str